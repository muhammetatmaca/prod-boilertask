# Veritabanı
DATABASE_URL="postgresql://user:password@localhost:5432/nest-db?schema=public"

# JWT Yapılandırması
JWT_ACCESS_SECRET="bu-kismi-cok-guclu-bir-dis-anahtar-ile-degistirin"
JWT_REFRESH_SECRET="bu-kismi-baska-bir-guclu-dis-anahtar-ile-degistirin"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Güvenlik Ayarları
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Uygulama Ayarları
NODE_ENV=development
PORT=3000
