# Veritabanı
DATABASE_URL="postgresql://user:password@postgres:5432/nest-db?schema=public"

# JWT Yapılandırması - BU DEĞERLERİ PROD ORTAMINDA MUTLAKA DEĞİŞTİRİN!
JWT_ACCESS_SECRET="en-az-32-karakterli-cok-guclu-bir-rastgele-dizgi-olusturun"
JWT_REFRESH_SECRET="yenileme-tokeni-icin-baska-bir-guclu-rastgele-dizgi-olusturun"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Güvenlik Ayarları
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Uygulama Ayarları
NODE_ENV=production
PORT=3000
