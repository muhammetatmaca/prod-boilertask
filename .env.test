# Veritabanı (Test veritabanı kullanın)
DATABASE_URL="postgresql://user:password@localhost:5432/nest-db-test?schema=public"

# JWT Yapılandırması
JWT_ACCESS_SECRET="test-ortami-gizli-anahtari"
JWT_REFRESH_SECRET="test-ortami-yenileme-anahtari"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Güvenlik Ayarları
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Uygulama Ayarları
NODE_ENV=test
PORT=3001
