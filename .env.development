# Veritabanı
DATABASE_URL="postgresql://user:password@localhost:5432/nest-db?schema=public"

# JWT Yapılandırması
JWT_ACCESS_SECRET="gelistirme-asamasindaki-gizli-anahtar"
JWT_REFRESH_SECRET="gelistirme-asamasindaki-yenileme-anahtari"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Güvenlik Ayarları
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Uygulama Ayarları
NODE_ENV=development
PORT=3000
